#!/bin/bash
# snap/local/teleop-split-launch
#
# Entry point for the `teleop` daemon app. Reads the runtime.env and
# params.yaml rendered by the configure hook (snap/hooks/configure) and execs
# the teleop_split ROS 2 node directly (no `ros2 launch` involved -- this is
# a single self-contained node, not a launch tree).
#
# This script runs inside the ros2-jazzy-ros-base extension's command-chain,
# so the ROS 2 underlay/overlay environment (AMENT_PREFIX_PATH,
# LD_LIBRARY_PATH, PYTHONPATH, ...) is already sourced.
set -eu

PARAMS_FILE="$SNAP_DATA/params.yaml"
RUNTIME_ENV="$SNAP_DATA/runtime.env"
TELEOP_SPLIT_EXE="$SNAP/opt/ros/snap/lib/so101_teleop/teleop_split"

if [ ! -f "$PARAMS_FILE" ]; then
  echo "so101-teleop: no configuration found yet at $PARAMS_FILE" >&2
  echo "so101-teleop: the configure hook should have created this on install" >&2
  exit 1
fi

# NAMESPACE, NODE_NAME, ROS_DOMAIN_ID, RMW_IMPLEMENTATION (all optional)
if [ -f "$RUNTIME_ENV" ]; then
  # shellcheck disable=SC1090
  . "$RUNTIME_ENV"
fi

if [ -n "${ROS_DOMAIN_ID:-}" ]; then
  export ROS_DOMAIN_ID
fi
if [ -n "${RMW_IMPLEMENTATION:-}" ]; then
  export RMW_IMPLEMENTATION
fi

set -- "$TELEOP_SPLIT_EXE" --ros-args --params-file "$PARAMS_FILE"

if [ -n "${NODE_NAME:-}" ]; then
  set -- "$@" -r __node:="$NODE_NAME"
fi

if [ -n "${NAMESPACE:-}" ]; then
  set -- "$@" -r __ns:="$NAMESPACE"
fi

echo "so101-teleop: exec: $*" >&2
exec "$@"
