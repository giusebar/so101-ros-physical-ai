#!/bin/bash
# snap/hooks/configure
#
# Applies `snap set so101-bringup <key>=<value>` configuration:
#   1. validates + fills in defaults
#   2. resolves per-robot calibration (LeRobot JSON) -> wrapped joints: YAML in $SNAP_DATA
#   3. renders $SNAP_DATA/runtime.env (consumed by snap/local/so101-bringup-launch)
#   4. (re)starts the daemon
set -e

get() {
  # $1 = key, $2 = default
  val="$(snapctl get "$1")"
  if [ -z "$val" ]; then
    val="$2"
  fi
  printf '%s' "$val"
}

LEADER_USB_PORT="$(get leader-usb-port /dev/so101_leader)"
FOLLOWER_USB_PORT="$(get follower-usb-port /dev/so101_follower)"
HARDWARE_TYPE="$(get hardware-type real)"          # real | mock
ARM_CONTROLLER="$(get arm-controller trajectory)"  # trajectory | forward
ROS_DOMAIN_ID="$(get ros-domain-id "")"
RMW_IMPLEMENTATION="$(get rmw-implementation "")"

LEADER_CALIBRATION_FILE="$(get leader-calibration-file "")"
FOLLOWER_CALIBRATION_FILE="$(get follower-calibration-file "")"

case "$HARDWARE_TYPE" in
  real|mock) ;;
  *)
    echo "so101-bringup: invalid hardware-type '$HARDWARE_TYPE' (expected real|mock)" >&2
    exit 1
    ;;
esac

case "$ARM_CONTROLLER" in
  trajectory) ARM_CONTROLLER_NAME=arm_trajectory_controller ;;
  forward) ARM_CONTROLLER_NAME=arm_forward_controller ;;
  *)
    echo "so101-bringup: invalid arm-controller '$ARM_CONTROLLER' (expected trajectory|forward)" >&2
    exit 1
    ;;
esac

mkdir -p "$SNAP_DATA"

BUNDLED_CALIB="$SNAP/opt/ros/snap/share/so101_bringup/config/hardware"
CAL_DIR="$SNAP_COMMON/calibration"
mkdir -p "$CAL_DIR"

# Resolve a calibration JSON path for one arm, with precedence:
#   snap-set override -> managed $SNAP_COMMON copy -> bundled default.
# Validated below; result echoed on stdout as the resolved JSON path (may be empty
# if all sources are missing).
resolve_calibration() {
  # $1 = arm role (leader|follower), $2 = override value (may be empty),
  # $3 = bundled default filename
  local override="$2"
  local bundled="$BUNDLED_CALIB/$3"

  if [ -n "$override" ]; then
    # `snap set` values are literal text: expand a leading $SNAP_COMMON / ~
    # so users can write the natural `$SNAP_COMMON/calibration/x.json`.
    case "$override" in
      \$SNAP_COMMON/*) override="$SNAP_COMMON/${override#\$SNAP_COMMON/}" ;;
      \$SNAP_COMMON)   override="$SNAP_COMMON" ;;
      ~/*)             override="$HOME/${override#\~/}" ;;
    esac
    case "$override" in
      "$SNAP_COMMON"/*) ;;
      *)
        echo "so101-bringup: ${1}-calibration-file '$override' is not under \$SNAP_COMMON ($SNAP_COMMON)" >&2
        echo "" # signal failure via empty path
        return
        ;;
    esac
    if [ ! -f "$override" ]; then
      echo "so101-bringup: ${1}-calibration-file '$override' does not exist" >&2
      echo ""
      return
    fi
    printf '%s' "$override"
    return
  fi

  if [ -f "$CAL_DIR/$1.json" ]; then
    printf '%s' "$CAL_DIR/$1.json"
    return
  fi
  if [ -f "$bundled" ]; then
    printf '%s' "$bundled"
    return
  fi
  echo "so101-bringup: no calibration JSON found for $1 (checked override, $CAL_DIR/$1.json, $bundled)" >&2
  echo ""
}

# Validate a LeRobot-style calibration JSON and merge it onto the bundled
# per-joint tuning base ($4), writing the driver's YAML schema to $2. The heavy
# lifting lives in the standalone $SNAP/usr/bin/wrap_calibration.py (kept out of
# this hook so it can be read/tested on its own); see that file for the
# calibration/tuning merge rationale.
# Returns non-zero on failure (bad JSON, missing joints, missing per-joint id).
wrap_calibration() {
  # $1 = input JSON path, $2 = output YAML path, $3 = arm role (for messages),
  # $4 = bundled tuning YAML base (may be missing/empty)
  python3 "$SNAP/usr/bin/wrap_calibration.py" "$1" "$2" "$3" "${4:-}"
}

LEADER_JSON="$(resolve_calibration leader  "$LEADER_CALIBRATION_FILE"  lerobot_leader_arm.json)"
FOLLOWER_JSON="$(resolve_calibration follower "$FOLLOWER_CALIBRATION_FILE" lerobot_follower_arm.json)"

CAL_ERR=0
LEADER_YAML="$SNAP_DATA/leader_joint_config.yaml"
FOLLOWER_YAML="$SNAP_DATA/follower_joint_config.yaml"

if [ -n "$LEADER_JSON" ]; then
  if ! wrap_calibration "$LEADER_JSON" "$LEADER_YAML" leader "$BUNDLED_CALIB/leader_joints.yaml"; then
    CAL_ERR=1
  fi
else
  CAL_ERR=1
fi

if [ -n "$FOLLOWER_JSON" ]; then
  if ! wrap_calibration "$FOLLOWER_JSON" "$FOLLOWER_YAML" follower "$BUNDLED_CALIB/follower_joints.yaml"; then
    CAL_ERR=1
  fi
else
  CAL_ERR=1
fi

if [ "$CAL_ERR" -ne 0 ]; then
  snapctl set-health blocked "calibration invalid or missing; see 'snap logs $SNAP_NAME' and fix 'snap set $SNAP_NAME leader-calibration-file=... follower-calibration-file=...' (paths under \$SNAP_COMMON)"
  # Do not restart into a broken calibration; keep the last good runtime.env.
  exit 1
fi

{
  echo "LEADER_USB_PORT=\"$LEADER_USB_PORT\""
  echo "FOLLOWER_USB_PORT=\"$FOLLOWER_USB_PORT\""
  echo "HARDWARE_TYPE=\"$HARDWARE_TYPE\""
  echo "ARM_CONTROLLER_NAME=\"$ARM_CONTROLLER_NAME\""
  echo "LEADER_JOINT_CONFIG_FILE=\"$LEADER_YAML\""
  echo "FOLLOWER_JOINT_CONFIG_FILE=\"$FOLLOWER_YAML\""
  [ -n "$ROS_DOMAIN_ID" ] && echo "ROS_DOMAIN_ID=\"$ROS_DOMAIN_ID\""
  [ -n "$RMW_IMPLEMENTATION" ] && echo "RMW_IMPLEMENTATION=\"$RMW_IMPLEMENTATION\""
  true
} > "$SNAP_DATA/runtime.env"

snapctl set-health okay

# Never auto-start the hardware daemon. An arm powering on unattended with a
# not-yet-verified calibration can torque its joints to positions computed from
# the wrong geometry (and, on the follower, drop under gravity when it later
# deactivates). The operator must explicitly start it AFTER confirming the
# active calibration matches THIS physical robot:
#
#     snap start so101-bringup.hardware
#
# If the daemon is ALREADY running, restart it so this new configuration takes
# effect; if it is stopped, leave it stopped and point the user at snap start.
if snapctl services "$SNAP_NAME.hardware" | grep -qw active; then
  snapctl restart "$SNAP_NAME.hardware" || true
else
  echo "so101-bringup: hardware daemon is not running. After verifying the active calibration matches THIS robot, start it with: snap start $SNAP_NAME.hardware" >&2
fi
