#!/bin/bash
# snap/hooks/configure
#
# Applies `snap set ai-vision-ros2 <key>=<value>` configuration for the
# Qualcomm / QNN depth variant. Mirrors the CPU variant's configure hook and
# adds the QNN execution-providers / backend keys. Renders
# $SNAP_DATA/params.yaml (ros__parameters for depth_anything_node) and
# $SNAP_DATA/runtime.env (namespace/node-name/DDS overrides).
set -e

get() {
  # $1 = key, $2 = default
  val="$(snapctl get "$1")"
  if [ -z "$val" ]; then
    val="$2"
  fi
  printf '%s' "$val"
}

get_number() {
  val="$(get "$1" "$2")"
  case "$val" in
    ''|*[!0-9.-]*)
      echo "ai-vision-ros2 (qualcomm depth): invalid number for $1: '$val'" >&2
      exit 1
      ;;
  esac
  printf '%s' "$val"
}

# ── Model selection ─────────────────────────────────────────────────────────
# `model` picks which bundled model + its matching pre/post-processing:
#   default : HuggingFace fp32 DepthAnything V2 Small, 308x308, ImageNet norm
#             outside the graph. Runs partly on the NPU.
#   aihub   : Qualcomm AI-Hub w8a16 model, 518x518, quantised uint16 I/O,
#             normalisation baked in. Runs FULLY on the Hexagon NPU.
# Individual keys below (model-path, model-input-size, input-normalization,
# input-quant-scale, ...) still override the per-variant defaults if set.
MODEL_VARIANT="$(get model default)"
case "$MODEL_VARIANT" in
  aihub|qualcomm|qnn|w8a16)
    DEF_MODEL_PATH="$SNAP/models/aihub/depth_anything_v2.onnx"
    DEF_INPUT_SIZE=518
    DEF_NORMALIZATION="unit"
    DEF_IN_QUANT_SCALE="0.00002101432801282499"
    DEF_IN_QUANT_ZP=9979
    DEF_OUT_DEQUANT_SCALE="0.00020078796660527587"
    DEF_OUT_DEQUANT_ZP=0
    ;;
  *)
    DEF_MODEL_PATH="$SNAP/models/depth_anything_v2_small.onnx"
    DEF_INPUT_SIZE=308
    DEF_NORMALIZATION="imagenet"
    DEF_IN_QUANT_SCALE="0.0"
    DEF_IN_QUANT_ZP=0
    DEF_OUT_DEQUANT_SCALE="0.0"
    DEF_OUT_DEQUANT_ZP=0
    ;;
esac
MODEL_PATH="$(get model-path "$DEF_MODEL_PATH")"

INPUT_IMAGE_TOPIC="$(get input-image-topic /static_camera/image_raw)"
OUTPUT_IMAGE_TOPIC="$(get output-image-topic /camera/depth/visualization)"
OUTPUT_DEPTH_TOPIC="$(get output-depth-topic /perception/depth)"
MODEL_INPUT_SIZE="$(get_number model-input-size "$DEF_INPUT_SIZE")"
INPUT_NORMALIZATION="$(get input-normalization "$DEF_NORMALIZATION")"
INPUT_QUANT_SCALE="$(get_number input-quant-scale "$DEF_IN_QUANT_SCALE")"
INPUT_QUANT_ZERO_POINT="$(get_number input-quant-zero-point "$DEF_IN_QUANT_ZP")"
OUTPUT_DEQUANT_SCALE="$(get_number output-dequant-scale "$DEF_OUT_DEQUANT_SCALE")"
OUTPUT_DEQUANT_ZERO_POINT="$(get_number output-dequant-zero-point "$DEF_OUT_DEQUANT_ZP")"
PUBLISH_WIDTH="$(get_number publish-width 256)"
PUBLISH_HEIGHT="$(get_number publish-height 256)"
MIN_PERIOD_S="$(get_number min-period-s 0.0)"
INTRA_OP_THREADS="$(get_number intra-op-threads 4)"
LOG_SEVERITY_LEVEL="$(get_number log-severity-level 2)"

# ── QNN / execution-provider selection ──────────────────────────────────────
# Comma-separated ORT providers in priority order. Default runs the depth
# model on the Qualcomm Hexagon NPU via the QNN HTP backend, falling back to
# CPU for unsupported nodes. qnn-backend-path selects the QNN accelerator:
#   htp = Hexagon NPU (default, ~12x faster than CPU on this board)
#   gpu = Adreno GPU (works but slower than CPU for this fp32 model)
#   cpu = QNN reference CPU
EXECUTION_PROVIDERS="$(get execution-providers "QNNExecutionProvider,CPUExecutionProvider")"
QNN_BACKEND_PATH="$(get qnn-backend-path "htp")"

# Protective-stop trigger logic (ROI proximity + hysteresis debounce),
# computed directly by depth_anything_node itself.
STOP_TOPIC="$(get stop-topic /safety/protective_stop)"
ROI="$(get roi "0.25,0.2,0.75,0.85")"
NEAR_THRESHOLD="$(get_number near-threshold 0.6)"
NEAR_MARGIN="$(get_number near-margin 0.15)"
MIN_AREA_RATIO="$(get_number min-area-ratio 0.12)"
FRAMES_TO_BLOCK="$(get_number frames-to-block 2)"
FRAMES_TO_CLEAR="$(get_number frames-to-clear 3)"

NAMESPACE="$(get namespace "")"
NODE_NAME="$(get node-name "")"
ROS_DOMAIN_ID="$(get ros-domain-id "")"
RMW_IMPLEMENTATION="$(get rmw-implementation "")"

mkdir -p "$SNAP_DATA"

# Convert the comma-separated provider list into a YAML flow list of quoted
# strings: "A,B,C" -> ["A", "B", "C"]
PROVIDERS_YAML="$(printf '%s' "$EXECUTION_PROVIDERS" | awk -F',' '{
  out="[";
  for (i=1; i<=NF; i++) {
    gsub(/^[ \t]+|[ \t]+$/, "", $i);
    out = out (i>1 ? ", " : "") "\"" $i "\"";
  }
  out = out "]";
  print out
}')"

{
  echo "/**:"
  echo "  ros__parameters:"
  echo "    model_path: \"$MODEL_PATH\""
  echo "    input_image_topic: \"$INPUT_IMAGE_TOPIC\""
  echo "    output_image_topic: \"$OUTPUT_IMAGE_TOPIC\""
  echo "    output_depth_topic: \"$OUTPUT_DEPTH_TOPIC\""
  echo "    model_input_size: $MODEL_INPUT_SIZE"
  echo "    input_normalization: \"$INPUT_NORMALIZATION\""
  echo "    input_quant_scale: $INPUT_QUANT_SCALE"
  echo "    input_quant_zero_point: $INPUT_QUANT_ZERO_POINT"
  echo "    output_dequant_scale: $OUTPUT_DEQUANT_SCALE"
  echo "    output_dequant_zero_point: $OUTPUT_DEQUANT_ZERO_POINT"
  echo "    publish_width: $PUBLISH_WIDTH"
  echo "    publish_height: $PUBLISH_HEIGHT"
  echo "    min_period_s: $MIN_PERIOD_S"
  echo "    intra_op_threads: $INTRA_OP_THREADS"
  echo "    log_severity_level: $LOG_SEVERITY_LEVEL"
  echo "    execution_providers: $PROVIDERS_YAML"
  echo "    qnn_backend_path: \"$QNN_BACKEND_PATH\""
  echo "    stop_topic: \"$STOP_TOPIC\""
  echo "    roi: \"$ROI\""
  echo "    near_threshold: $NEAR_THRESHOLD"
  echo "    near_margin: $NEAR_MARGIN"
  echo "    min_area_ratio: $MIN_AREA_RATIO"
  echo "    frames_to_block: $FRAMES_TO_BLOCK"
  echo "    frames_to_clear: $FRAMES_TO_CLEAR"
} > "$SNAP_DATA/params.yaml"

{
  [ -n "$NAMESPACE" ] && echo "NAMESPACE=\"$NAMESPACE\""
  [ -n "$NODE_NAME" ] && echo "NODE_NAME=\"$NODE_NAME\""
  [ -n "$ROS_DOMAIN_ID" ] && echo "ROS_DOMAIN_ID=\"$ROS_DOMAIN_ID\""
  [ -n "$RMW_IMPLEMENTATION" ] && echo "RMW_IMPLEMENTATION=\"$RMW_IMPLEMENTATION\""
  true
} > "$SNAP_DATA/runtime.env"

snapctl set-health okay
snapctl start --enable "$SNAP_NAME.perception" || true
snapctl restart "$SNAP_NAME.perception" || true
