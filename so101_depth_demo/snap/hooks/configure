#!/bin/bash
# snap/hooks/configure
#
# Applies `snap set ai-vision-ros2 <key>=<value>` configuration for the
# NVIDIA / Jetson depth variant. Mirrors the CPU variant's configure hook
# and adds the NVIDIA-specific execution-providers / engine-cache-dir keys.
# Renders $SNAP_DATA/params.yaml (ros__parameters for depth_anything_node)
# and $SNAP_DATA/runtime.env (namespace/node-name/DDS overrides).
set -e

get() {
  # $1 = key, $2 = default
  val="$(snapctl get "$1")"
  if [ -z "$val" ]; then
    val="$2"
  fi
  printf '%s' "$val"
}

get_number() {
  val="$(get "$1" "$2")"
  case "$val" in
    ''|*[!0-9.-]*)
      echo "ai-vision-ros2 (nvidia depth): invalid number for $1: '$val'" >&2
      exit 1
      ;;
  esac
  printf '%s' "$val"
}

MODEL_PATH="$SNAP/models/depth_anything_v2_small.onnx"

INPUT_IMAGE_TOPIC="$(get input-image-topic /static_camera/image_raw)"
OUTPUT_IMAGE_TOPIC="$(get output-image-topic /camera/depth/visualization)"
OUTPUT_DEPTH_TOPIC="$(get output-depth-topic /perception/depth)"
MODEL_INPUT_SIZE="$(get_number model-input-size 308)"
PUBLISH_WIDTH="$(get_number publish-width 256)"
PUBLISH_HEIGHT="$(get_number publish-height 256)"
MIN_PERIOD_S="$(get_number min-period-s 0.0)"
INTRA_OP_THREADS="$(get_number intra-op-threads 4)"

# ── NVIDIA / execution-provider selection ───────────────────────────────────
# Comma-separated ORT providers in priority order. Default runs the depth
# model on the Jetson GPU via TensorRT (fp16), falling back to CUDA then CPU.
# ORT builds + caches the TensorRT engine under engine-cache-dir on first run.
EXECUTION_PROVIDERS="$(get execution-providers "TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider")"
ENGINE_CACHE_DIR="$(get engine-cache-dir "$SNAP_DATA/trt_engines")"

# Protective-stop trigger logic (ROI proximity + hysteresis debounce),
# computed directly by depth_anything_node itself.
STOP_TOPIC="$(get stop-topic /safety/protective_stop)"
ROI="$(get roi "0.25,0.2,0.75,0.85")"
NEAR_THRESHOLD="$(get_number near-threshold 0.6)"
NEAR_MARGIN="$(get_number near-margin 0.15)"
MIN_AREA_RATIO="$(get_number min-area-ratio 0.12)"
FRAMES_TO_BLOCK="$(get_number frames-to-block 2)"
FRAMES_TO_CLEAR="$(get_number frames-to-clear 3)"

NAMESPACE="$(get namespace "")"
NODE_NAME="$(get node-name "")"
ROS_DOMAIN_ID="$(get ros-domain-id "")"
RMW_IMPLEMENTATION="$(get rmw-implementation "")"

mkdir -p "$SNAP_DATA"
mkdir -p "$ENGINE_CACHE_DIR"

# Convert the comma-separated provider list into a YAML flow list of quoted
# strings: "A,B,C" -> ["A", "B", "C"]
PROVIDERS_YAML="$(printf '%s' "$EXECUTION_PROVIDERS" | awk -F',' '{
  out="[";
  for (i=1; i<=NF; i++) {
    gsub(/^[ \t]+|[ \t]+$/, "", $i);
    out = out (i>1 ? ", " : "") "\"" $i "\"";
  }
  out = out "]";
  print out
}')"

{
  echo "/**:"
  echo "  ros__parameters:"
  echo "    model_path: \"$MODEL_PATH\""
  echo "    input_image_topic: \"$INPUT_IMAGE_TOPIC\""
  echo "    output_image_topic: \"$OUTPUT_IMAGE_TOPIC\""
  echo "    output_depth_topic: \"$OUTPUT_DEPTH_TOPIC\""
  echo "    model_input_size: $MODEL_INPUT_SIZE"
  echo "    publish_width: $PUBLISH_WIDTH"
  echo "    publish_height: $PUBLISH_HEIGHT"
  echo "    min_period_s: $MIN_PERIOD_S"
  echo "    intra_op_threads: $INTRA_OP_THREADS"
  echo "    execution_providers: $PROVIDERS_YAML"
  echo "    engine_cache_dir: \"$ENGINE_CACHE_DIR\""
  echo "    stop_topic: \"$STOP_TOPIC\""
  echo "    roi: \"$ROI\""
  echo "    near_threshold: $NEAR_THRESHOLD"
  echo "    near_margin: $NEAR_MARGIN"
  echo "    min_area_ratio: $MIN_AREA_RATIO"
  echo "    frames_to_block: $FRAMES_TO_BLOCK"
  echo "    frames_to_clear: $FRAMES_TO_CLEAR"
} > "$SNAP_DATA/params.yaml"

{
  [ -n "$NAMESPACE" ] && echo "NAMESPACE=\"$NAMESPACE\""
  [ -n "$NODE_NAME" ] && echo "NODE_NAME=\"$NODE_NAME\""
  [ -n "$ROS_DOMAIN_ID" ] && echo "ROS_DOMAIN_ID=\"$ROS_DOMAIN_ID\""
  [ -n "$RMW_IMPLEMENTATION" ] && echo "RMW_IMPLEMENTATION=\"$RMW_IMPLEMENTATION\""
  echo "ORT_ENGINE_CACHE_DIR=\"$ENGINE_CACHE_DIR\""
  true
} > "$SNAP_DATA/runtime.env"

snapctl set-health okay
snapctl start --enable "$SNAP_NAME.perception" || true
snapctl restart "$SNAP_NAME.perception" || true
