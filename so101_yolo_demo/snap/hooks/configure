#!/bin/bash
# snap/hooks/configure
#
# Applies `snap set yolodetect <key>=<value>` configuration:
#   1. fills in defaults (matching so101_yolo_demo/launch/yolo_demo.launch.py)
#   2. renders $SNAP_DATA/params.yaml (ros__parameters block for
#      yolo_detect_node) — model_path is NOT user-settable, it always points
#      at the weights mounted by the yolodetect-model content snap
#   3. renders $SNAP_DATA/runtime.env (namespace/node-name/DDS overrides for
#      the launcher, which are not yolo_detect_node ROS parameters)
#   4. gates startup on the model file actually being present (the content
#      interface may not be connected yet, e.g. right after a --dangerous
#      local install) and enables + (re)starts the daemon once it is
#
# See snap/local/yolodetect-launch for the consumer side.
set -e

get() {
  # $1 = key, $2 = default
  val="$(snapctl get "$1")"
  if [ -z "$val" ]; then
    val="$2"
  fi
  printf '%s' "$val"
}

get_number() {
  val="$(get "$1" "$2")"
  case "$val" in
    ''|*[!0-9.-]*)
      echo "yolodetect: invalid number for $1: '$val'" >&2
      exit 1
      ;;
  esac
  printf '%s' "$val"
}

MODEL_PATH="$SNAP/models/yolov8n.onnx"

INPUT_IMAGE_TOPIC="$(get input-image-topic /static_camera/image_raw)"
OUTPUT_IMAGE_TOPIC="$(get output-image-topic /camera/detections/visualization)"
OUTPUT_DETECTIONS_TOPIC="$(get output-detections-topic /perception/detections)"
INPUT_SIZE="$(get_number input-size 640)"
CONF_THRESHOLD="$(get_number conf-threshold 0.4)"
CLASS_FILTER="$(get class-filter person)"
MIN_PERIOD_S="$(get_number min-period-s 0.0)"
INTRA_OP_THREADS="$(get_number intra-op-threads 0)"

NAMESPACE="$(get namespace "")"
NODE_NAME="$(get node-name "")"
ROS_DOMAIN_ID="$(get ros-domain-id "")"
RMW_IMPLEMENTATION="$(get rmw-implementation "")"

mkdir -p "$SNAP_DATA"

{
  echo "/**:"
  echo "  ros__parameters:"
  echo "    model_path: \"$MODEL_PATH\""
  echo "    input_image_topic: \"$INPUT_IMAGE_TOPIC\""
  echo "    output_image_topic: \"$OUTPUT_IMAGE_TOPIC\""
  echo "    output_detections_topic: \"$OUTPUT_DETECTIONS_TOPIC\""
  echo "    input_size: $INPUT_SIZE"
  echo "    conf_threshold: $CONF_THRESHOLD"
  echo "    class_filter: \"$CLASS_FILTER\""
  echo "    min_period_s: $MIN_PERIOD_S"
  echo "    intra_op_threads: $INTRA_OP_THREADS"
} > "$SNAP_DATA/params.yaml"

{
  [ -n "$NAMESPACE" ] && echo "NAMESPACE=\"$NAMESPACE\""
  [ -n "$NODE_NAME" ] && echo "NODE_NAME=\"$NODE_NAME\""
  [ -n "$ROS_DOMAIN_ID" ] && echo "ROS_DOMAIN_ID=\"$ROS_DOMAIN_ID\""
  [ -n "$RMW_IMPLEMENTATION" ] && echo "RMW_IMPLEMENTATION=\"$RMW_IMPLEMENTATION\""
  true
} > "$SNAP_DATA/runtime.env"

if [ -f "$MODEL_PATH" ]; then
  snapctl set-health okay
  snapctl start --enable "$SNAP_NAME.yolodetect" || true
  snapctl restart "$SNAP_NAME.yolodetect" || true
else
  snapctl set-health blocked \
    "model not found at $MODEL_PATH -- connect the content interface: snap connect $SNAP_NAME:yolodetect-model yolodetect-model:yolodetect-model"
fi
